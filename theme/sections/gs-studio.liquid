<div class="gs gs-rpage gs-studio-page" id="gs-top">
<header class="gs-header"><nav class="gs-wrap gs-nav">
  <a href="/" class="gs-logo" aria-label="Garden Studio"><img src="https://cdn.shopify.com/s/files/1/1047/0621/2187/files/gs-symbol.png?width=96" alt="" width="32" height="32"><span>Garden Studio<em>.</em></span></a>
  <div class="gs-navr">
